MONGODB_URI=mongodb://127.0.0.1:27017/no-dues
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-string
# Required in production; without it, dev uploads fall back to public/uploads
BLOB_READ_WRITE_TOKEN=
# Production refuses to fall back to the local JSON store (and its default
# passwords) when MongoDB is unreachable. Set to true only for throwaway demos.
# ALLOW_LOCAL_DATA=false
